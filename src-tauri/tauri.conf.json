{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Architecture Project Tracker",
  "version": "0.1.0",
  "identifier": "com.archtracker.app",
  "build": {
    "beforeDevCommand": "yarn vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "yarn vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Architecture Project Tracker",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
